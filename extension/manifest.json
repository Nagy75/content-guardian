{
  "manifest_version": 3,
  "name": "Content Guardian",
  "version": "0.1.0",
  "description": "Filter inappropriate captions and skip parent-configured movie intervals.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
